{
  "name": "reactive-props",
  "version": "0.1.0",
  "description": "Typed reactive object properties backed by RxJS BehaviorSubjects.",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.js",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepeerie/reactive-props.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tests/types/tsconfig.json",
    "test": "npm run build && npm run typecheck && node --test tests/*.test.cjs",
    "test:package": "npm run build && node scripts/check-package.cjs",
    "example": "npm run build && node examples/basic.cjs",
    "prepack": "npm test"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
